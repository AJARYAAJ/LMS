APP_NAME="LMS Lead Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this API: campaign emails point their open pixel and tracked
# links here, so it must be reachable from recipients' inboxes in production.
APP_URL=http://localhost:8000
# Used for links in emails, digests and chat alerts.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Lets `php artisan serve` answer the SPA's parallel requests concurrently.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Use PostgreSQL in production (see docker-compose.yml):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=lms
# DB_USERNAME=lms
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vendors (email, SMS/WhatsApp, AI voice, Claude, Slack/Teams) are connected per organization
# in Settings → Integrations. The values below are server-wide fallbacks only.
#
# Optional: AI lead briefs and call analysis (Claude). Leave empty to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# SMS / WhatsApp: "log" records messages on the timeline without sending; "twilio" delivers.
MESSAGING_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Let people connect their own Gmail / Outlook mailbox and calendar (Profile → Email & calendar).
# Create an OAuth "web application" client and add the redirect URL
#   {APP_URL}/api/v1/connected-accounts/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Push notifications. Without keys a VAPID pair is created on first use and kept in storage/;
# run `php artisan push:vapid` and pin the pair here for production (and multiple servers).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourcompany.com
# Native app push (mobile/): Firebase service-account JSON, or a path to the file.
FCM_CREDENTIALS=
